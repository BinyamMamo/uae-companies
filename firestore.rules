rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may read and write only their own profile document.
    // This holds saved companies, lists, interests and home location — nothing
    // is shared between users, so there is no public read path at all.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
