# Firebase: Google sign-in, Firestore sync, and Analytics.
# Leave blank to hide sign-in and keep everything local to the browser.
# These ship in the client bundle and are not secrets — access is controlled by
# Firestore rules and the project's authorised domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Analytics only starts once a Google Analytics property is linked to the
# Firebase project and this is set. Without it the app fires no events.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Google OAuth client ID, used only for the One Tap prompt.
VITE_GOOGLE_CLIENT_ID=
