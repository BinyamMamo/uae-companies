# Product analytics (PostHog). Leave blank to disable analytics entirely —
# the app runs fine without it and fires no events.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google sign-in (Firebase). Leave blank to hide sign-in and keep everything
# local to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google OAuth client ID, used only for the One Tap prompt.
VITE_GOOGLE_CLIENT_ID=
